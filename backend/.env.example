# Used when running the API on your machine (uvicorn), NOT inside Docker.
# Copy:  copy .env.example .env
#
# NEVER commit backend/.env — it is gitignored.
# Production checklist: docs/PRODUCTION_ENV.md

# ---------- Core ----------
# development | production
APP_ENV=development

# Docker Compose overrides this to host "db". Local uvicorn → localhost:
DATABASE_URL=postgresql://postgres:root@localhost:5432/TrekPal

# Must be 32+ random characters in production (not this placeholder).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
# 1440 = 1 day. Prefer shorter in production if you want faster expiry.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins. Never use * in production.
CORS_ORIGINS=http://localhost:3000

# httpOnly session cookie. Leave AUTH_COOKIE_SECURE unset locally (HTTP).
AUTH_COOKIE_NAME=trekpal_access
# AUTH_COOKIE_SECURE=false
# Local default SameSite=lax. Production default=none (Vercel FE + Railway API).
# AUTH_COOKIE_SAMESITE=lax
# If SameSite=none, Secure MUST be true (browser rule).

# ---------- Internal ML playground (/ml) ----------
# On automatically in development. Off in production unless BOTH are true:
# ENABLE_INTERNAL_ML=true
# ALLOW_INTERNAL_ML_IN_PRODUCTION=true

# ---------- Chat rate limit (R10) ----------
CHAT_RATE_LIMIT_PER_HOUR=20

# ---------- Groq AI (optional locally; recommended in production for chat/itinerary) ----------
# https://console.groq.com/
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Frontend (set in frontend/.env.local — see frontend/.env.example) ----------
# NEXT_PUBLIC_API_URL=http://localhost:8000
