# Used when running the API on your machine (uvicorn), NOT inside Docker.
# Copy:  copy .env.example .env
#
# Docker Compose sets DATABASE_URL automatically to use host "db".
# For local uvicorn against Docker Postgres, use localhost:

DATABASE_URL=postgresql://postgres:root@localhost:5432/TrekPal

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# ---------- Groq AI (Phase 3) ----------
#
# Get your API key from https://console.groq.com/
# Add it as GROQ_API_KEY and optionally set GROQ_MODEL.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
