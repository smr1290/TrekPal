# Copy to .env.local for local Next.js (never commit secrets).
#
# Local (API on Docker/uvicorn):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production (Vercel) — use same-origin proxy so phone login cookies work:
#   API_PROXY_TARGET=https://YOUR-API.up.railway.app
#   NEXT_PUBLIC_API_URL=/backend
# See docs/DEPLOY.md
